NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USER=root
DB_PASSWORD=your_password
JWT_SECRET=replace_with_secure_secret

# ====================================
# OPENAI CONFIGURATION (Dùng cho AI chấm ESSAY)
# ====================================
# API Key từ https://platform.openai.com/api-keys
# Tạo key mới (không dùng shared org key)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model: gpt-4, gpt-3.5-turbo, gpt-4o
OPENAI_MODEL=gpt-3.5-turbo

# ====================================
# YOUTUBE CONFIGURATION (Subscribe-to-Watch Feature)
# ====================================
# ID của channel YouTube cần yêu cầu subscription
# Lấy từ https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx